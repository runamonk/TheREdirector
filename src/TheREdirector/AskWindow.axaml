<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TheREdirector.AskWindow"
        Title="The Redirector"
        Icon="avares://TheREdirector/Assets/TheREdirector.ico"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterScreen" Topmost="True">
    <StackPanel Margin="20" Spacing="16">
        <TextBlock FontSize="16" FontWeight="SemiBold" Text="Edge keeps starting" />
        <TextBlock x:Name="Message" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Let Edge run" Click="LetRunClicked" />
            <Button Content="Keep closing it" Classes="accent" IsDefault="True" Click="KeepClosingClicked" />
        </StackPanel>
    </StackPanel>
</Window>
